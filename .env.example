# Anthropic API key - get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Review UI port
PORT=5004

# Default model for LLM structured extraction (src/extract/llm_extract.py).
# Check https://platform.claude.com/docs/en/about-claude/models/overview if
# this drifts far from the build date and confirm the alias still resolves.
ANTHROPIC_MODEL=claude-sonnet-5
